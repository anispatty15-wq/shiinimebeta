rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isLoggedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── /users/{uid} ──────────────────────────────────────
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);

      // User can update own doc but NOT roles field
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['roles'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['adultStatus'])
          || request.resource.data.adultStatus == 'pending'
        );

      // Admin can update any user doc (approve/reject/set roles)
      allow update: if isAdmin();
    }

    // ── /admins/{uid} ─────────────────────────────────────
    // ANY logged-in user can read their OWN admin doc
    // (needed for syncProfile to check if they are admin)
    match /admins/{uid} {
      allow read:  if isLoggedIn();  // any logged-in user can check
      allow write: if false;         // only via Firebase Console
    }
  }
}
