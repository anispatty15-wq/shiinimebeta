rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() { return request.auth != null; }
    function isOwner(uid) { return isLoggedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isLoggedIn() &&
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || request.auth.uid == 'pp4P99R0xdgB1fk4dUjFAnZsAnK2'
          || (
            request.auth.token.email == 'anispatty17@gmail.com'
          )
        );
    }

    // User profiles - PUBLIC READ for friend system
    match /users/{uid} {
      allow read:   if true;  // Public read so users can view each other's profiles
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['adultStatus'])
            || request.resource.data.adultStatus == 'pending');
      allow update: if isAdmin();
    }

    // Admin list — any logged-in user can check if they are admin
    match /admins/{uid} {
      allow read:  if isLoggedIn();
      allow write: if false;
    }

    // Notifications are created for another logged-in user and owned by recipient.
    match /notifications/{notificationId} {
      allow read, update, delete: if isLoggedIn() && resource.data.userId == request.auth.uid;
      allow create: if isLoggedIn()
        && request.resource.data.userId != request.auth.uid
        && (
          (
            request.resource.data.keys().hasAny(['senderId']) &&
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.type in ['chat_message', 'friend_request', 'friend_accepted']
          ) ||
          (
            request.resource.data.type == 'adult_request' &&
            request.resource.data.userId == 'pp4P99R0xdgB1fk4dUjFAnZsAnK2' &&
            request.resource.data.senderId == request.auth.uid
          ) ||
          (
            isAdmin() &&
            request.resource.data.type in ['new_episode', 'announcement']
          )
        );
    }

    // Comments — public read, logged-in write (own messages only)
    match /comments/{episodeSlug}/messages/{msgId} {
      allow read:   if true;
      allow create: if isLoggedIn()
        && request.resource.data.uid == request.auth.uid
        && (!('text' in request.resource.data) || request.resource.data.text.size() <= 500)
        && ((!('text' in request.resource.data)) || request.resource.data.text.size() > 0 ||
            request.resource.data.keys().hasAny(['mediaUrl', 'giftId']));
      // Allow update only for likes field (any logged-in user can like)
      allow update: if isLoggedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    // Cloud sync — history, bookmarks, watched slugs (owner only)
    match /userData/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Per-user chat deletion markers. Messages remain available to the other participant.
    match /userData/{uid}/chatDeletions/{conversationId} {
      allow read, write: if isOwner(uid);
    }

    // Friend requests — both sender and receiver can read/delete
    match /friendRequests/{requestId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() &&
        ((request.resource.data.keys().hasAny(['from']) &&
          request.resource.data.from == request.auth.uid) ||
         (request.resource.data.keys().hasAny(['fromUserId']) &&
          request.resource.data.fromUserId == request.auth.uid));
      allow update: if isLoggedIn() &&
        ((resource.data.keys().hasAny(['to']) &&
          resource.data.to == request.auth.uid) ||
         (resource.data.keys().hasAny(['toUserId']) &&
          resource.data.toUserId == request.auth.uid));
      allow delete: if isLoggedIn() && 
        ((resource.data.keys().hasAny(['from']) &&
          resource.data.from == request.auth.uid) ||
         (resource.data.keys().hasAny(['to']) &&
          resource.data.to == request.auth.uid) ||
         (resource.data.keys().hasAny(['fromUserId']) &&
          resource.data.fromUserId == request.auth.uid) ||
         (resource.data.keys().hasAny(['toUserId']) &&
          resource.data.toUserId == request.auth.uid));
    }

    // Friends list — both users can read/write
    match /friends/{friendshipId} {
      allow read: if isLoggedIn();
      allow create, update: if isLoggedIn() &&
        request.auth.uid in [request.resource.data.userId, request.resource.data.friendId];
      allow delete: if isLoggedIn() &&
        request.auth.uid in [resource.data.userId, resource.data.friendId];
    }

    // Conversations (DM chats) — only participants can read/write
    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if isLoggedIn() && 
        conversationId.matches('.*' + request.auth.uid + '.*');
      allow create: if isLoggedIn() && 
        request.resource.data.senderId == request.auth.uid && 
        (!('text' in request.resource.data) || request.resource.data.text.size() <= 500) &&
        (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl.size() <= 900000) &&
        (!('mediaUrl' in request.resource.data) || request.resource.data.mediaUrl.size() <= 900000) &&
        (!('mediaType' in request.resource.data) || request.resource.data.mediaType in ['image', 'video']) &&
        (('text' in request.resource.data && request.resource.data.text.size() > 0) ||
         request.resource.data.keys().hasAny(['imageUrl', 'mediaUrl', 'giftId']));
      allow update: if isLoggedIn()
        && resource.data.senderId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'text', 'imageUrl', 'mediaUrl', 'giftId', 'giftName', 'giftEmoji', 'deletedForAll', 'deletedAt'
        ])
        && (
          request.resource.data.deletedForAll == true
          || (resource.data.deletedForAll == true && request.resource.data.deletedForAll == false)
        );
    }
  }
}
